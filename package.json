{
  "name": "pagination-dropdown-select",
  "version": "1.0.9",
  "description": "Accessible pagination and page-size dropdowns for React and Next.js.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "react",
    "nextjs",
    "pagination",
    "dropdown",
    "select",
    "accessibility",
    "typescript",
    "huachenlihx"
  ],
  "author": "Hua Chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huachenlihx/pagination-dropdown-select.git"
  },
  "homepage": "https://github.com/huachenlihx/pagination-dropdown-select#readme",
  "bugs": {
    "url": "https://github.com/huachenlihx/pagination-dropdown-select/issues"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@testing-library/jest-dom": "^6.9.0",
    "jest-axe": "^10.0.0",
    "@types/jest-axe": "^3.5.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "tsup": "^8.5.1",
    "vitest": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0"
  }
}
